;******************************************************************************
;  init_msg_flds - setup the message array and the msg_ptr field and init it.
;******************************************************************************
:init_msg_flds
#proc
cmd init_msg_flds
   ;
   ;Notice that the following defines are NOT local.  This is on purpose so
   ;that we can use these fields in all programs.  This is a mod that is
   ;possible due to Pro 5.0.
   ;
   ;define MESSAGE type A size 78 array 16
   define msg_ptr type p
   msg_ptr -> message[1]
   ret
#endp
:end of init_msg_flds
;
;******************************************************************************
;  key_srch - allow the user to select from a group of keys for the file.
;******************************************************************************
:key_srch
