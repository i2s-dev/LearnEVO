func key_srch key_srch_name,key_srch_hndl
    chain tpath()*'srchkeys' with key_srch_name
    clr @key_srch_hndl buff
    ret .t.
:end of key_srch
;
;******************************************************************************
;  degs - Radians to Degrees
;******************************************************************************
:degs
#proc
define rad_value local
func degs rad_value
   ret ((rad_value*360)/(2*pi()))
#endp
:end of degs
;
;******************************************************************************
;  rads - Degrees to Radians
;******************************************************************************
:rads
#proc
define deg_value local
func rads deg_value
   ret (deg_value*2*pi())/360
#endp
:end of rads
;
;******************************************************************************
;  pv - present value
;******************************************************************************
:pv
#proc
define pv_amt,pv_yirate,pv_yrs,pv_ppy type n size 15 dec 4 local
func pv pv_amt,pv_yirate,pv_yrs,pv_ppy
    ret pv_amt*(1.00/((1.00+(pv_yirate/100.00)/pv_ppy)^(pv_yrs*pv_ppy)))
#endp
:end of pv
;
;******************************************************************************
;  pva - present value annuity
;******************************************************************************
:pva
#proc
define pva_amt,pva_yirate,pva_yrs,pva_ppy type n size 15 dec 4 local
func pva pva_amt,pva_yirate,pva_yrs,pva_ppy
    ret pva_amt*((1.00-1.00/((1.00+(pva_yirate/100.00)/pva_ppy)^(pva_yrs*pva_ppy)))/((pva_yirate/100.00)/pva_ppy))
#endp
:end of pva
;
;******************************************************************************
;  amort - amortizition of a loan
;******************************************************************************
:amort
#proc
define amt_amt,amt_yirate,amt_yrs,amt_ppy type n size 15 dec 4 local
func amort amt_amt,amt_yirate,amt_yrs,amt_ppy
    ret amt_amt/((1.00-1.00/((1.00+(amt_yirate/100.00)/amt_ppy)^(amt_yrs*amt_ppy)))/((amt_yirate/100.00)/amt_ppy))
#endp
:end of amort
;
;******************************************************************************
;  fv - future value
;******************************************************************************
:fv
#proc
define fv_amt,fv_yirate,fv_yrs,fv_ppy type n size 15 dec 4 local
func fv fv_amt,fv_yirate,fv_yrs,fv_ppy
    ret fv_amt*((1.00+(fv_yirate/100.00)/fv_ppy)^(fv_yrs*fv_ppy))
#endp
:end of fv
;
;******************************************************************************
;  fva - future value annuity
;******************************************************************************
:fva
#proc
define fva_amt,fva_yirate,fva_yrs,fva_ppy type n size 15 dec 4 local
func fva fva_amt,fva_yirate,fva_yrs,fva_ppy
    ret fva_amt*((((1.00+(fva_yirate/100.00)/fva_ppy)^(fva_yrs*fva_ppy))-1)/((fva_yirate/100.00)/fva_ppy))
#endp
:end of fva
;
;******************************************************************************
;  sink - sinking fund
;******************************************************************************
:sink
#proc
define sink_amt,sink_yirate,sink_yrs,sink_ppy type n size 15 dec 4 local
func sink sink_amt,sink_yirate,sink_yrs,sink_ppy
    ret sink_amt/((((1.00+(sink_yirate/100.00)/sink_ppy)^(sink_yrs*sink_ppy))-1)/((sink_yirate/100.00)/sink_ppy))
#endp
:end of sink
;
;******************************************************************************
;  ent_list - display a list of msgs rather than a WRAP'd field and enter
;             a chr at the end.
;******************************************************************************
:ent_list
#proc
define el_array_ptr type p local
define el_num,el_wdt,el_cntr type i local
define el_chr,el_pwhr_hldr type a size 1 local up
define el_mask type a size 25 local
func ent_list el_array_ptr,el_num,el_chr,el_mask
   ;determine the widest item
   define el_col,el_row type i local
   if el_num=0 then ret ''
   init_msg_flds
   xtrap save ignr
   el_wdt=0
   el_pwhr_hldr=pwhr()
   pset pwhr 's'
   for(el_cntr;1;el_num;1)
      if size(@el_array_ptr[el_cntr],'a')>el_wdt then el_wdt=size(@el_array_ptr[el_cntr],'a')
   next
   ;we now have the max size, setup the window
   saves
   window at 40-((el_wdt+6)/2),26-(el_num+2) len el_num+2 wdt el_wdt+6 box 's' wcolor err
   for(el_cntr;1;el_num;1)
      ? trim(@el_array_ptr[el_cntr],'t') at 2,el_cntr nocr color err ptw s
   next
   el_chr=up(el_chr)
   if el_mask='' then el_mask='YN'
   el_col=col()+1
   el_row=row()
   upar
   enter el_chr at el_col,el_row acr up mask el_mask
   redsp
   pset pwhr el_pwhr_hldr
   xtrap rstr
   ret el_chr
#endp
:end of ent_list
;
;******************************************************************************
;  prg_list - display a list of active programs and allow the user to quit
;             back to a certain level
;******************************************************************************
:prg_list
#proc
define pl_action type a size 1 local up
define pl_name type a size 30 local
define pl_hldr type b local reset
cmd prg_list pl_action,pl_name
   ;this routine will do the following:
   ;'A' - Add a name to the program list
   ;'R' - Remove the last item from the program list
   ;this routine is called by all programs as they enter and exit to keep
   ;track of which programs are active.
   trap int ignr
   if pl_cntr=0
      ;this is the first program run.  We need to initialize the
      ;counter and array
      inc pl_cntr
      pl_hldr=0
      pl_array[1]=' A - Exit to DOS'
      pl_lvl_array[1]=0       && quit to 0
   endif
   if up(pl_action)='R'
      ;remove the current level
      dec pl_cntr
      pl_hldr=pl_lvl_array[pl_cntr]
      quit pl_lvl_array[pl_cntr]
   else_if up(pl_action)='A'
      ;add this program name to the array
      if pl_cntr<20
         inc pl_cntr
         inc pl_hldr
         pl_array[pl_cntr]=' '+chr(64+pl_cntr)+' '+pl_name
         pl_lvl_array[pl_cntr]=pl_hldr
      endif
   else_if up(pl_action)='I'
      ;this is called by the main menu program when it wants to inc the
      ;pl_hldr value but doesn't want to add to the list.
      inc   pl_hldr
   endif
   trap int dflt
   ret
#endp
:end of msg_list
;
;
;
;******************************************************************************
;  chse_prt - choose the printer if multiple
;******************************************************************************
:chse_prt
#proc
define laser_printer type l
define post_prg type a size 8
define post_prg_run type a size 1
cmd chse_prt
   ;this routine will allow the user to chose a printer if there are multiple
   ;in FILECHSP.
   if Windows()
     if Win_laser_prt() gosub cp_set_laser
     ;in Windows we don't have to do anything else.
     ret
   endif
   define bksyprtr_path type a size 60 local
   bksyprtr_path=getenv('BKPRINT')
   if bksyprtr_path<>''
      bksyprtr_path=chk_path_chr(bksyprtr_path,60)
      openv 'bksyprtr' fnum bksyprtr_hndl ext 'B' path bksyprtr_path
   else
      openv 'bksyprtr' fnum bksyprtr_hndl ext 'B'
   endif
   if trc(bksyprtr_hndl)=0
      ;there are no entries
      close @bksyprtr_hndl
      ret
   endif
   ;
   ;if we're here there's at least one entry.  If there is more than one then
   ;display a list to allow the user to choose which one they want.
   ;
   if trc(bksyprtr_hndl)>1
      ;there are multiple choices, display them.
      saves
      window at 23,15 len 10 wdt 34 box 's' wcolor wc bcolor bc shd 'r' scolor sc ttlw 'l' ttl ' Choose Printer '
      listf bksy.prtr.name file @bksyprtr_hndl key bksy.prtr.name ccolor cc menu up ecolor datc
      redsp
      ;if the user presses the ESC key the program will use whatever is
      ;in the setup program.
      if bksy.prtr.name=''
        close @bksyprtr_hndl
        ret
      endif
   else
      ;only one choice, use it.  We allow the programmer to set it up this
      ;way so that s/he can change the pset values and make sure the correct
      ;printer driver is loaded without having to worry about the TAS50.OVL
      ;file.
      findv f fnum bksyprtr_hndl key bksy.prtr.name
   endif
   ;
   ;if we're here something needs to be done.  Let's load the printer driver
   ;and make sure the print specs are set.
   ;
   post_prg=bksy.prtr.post          ;save the post prg name and whether or
   post_prg_run=bksy.prtr.prun      ;not it's a run program.
   if bksy.prtr.exec<>''
      ;there is a control file that needs to be executed here first.  If
      ;bksy.prtr.tas='Y' then we need to run it, otherwise it's a EXEC prg.
      ;In both cases we assume the program is in the Adv sub-directory.
      if bksy.prtr.tas='Y'
         chain bksy.prgs.whr*bksy.prtr.exec
      else
         exec bksy.prgs.whr*bksy.prtr.exec
      endif
   endif
   ld_pdrv bksy.prtr.type
   prt_num bksy.prtr.lptnm
   pset wdt bksy.prtr.pwdt tlnes bksy.prtr.pmax plnes bksy.prtr.pplne
   laser_printer=.f.
   if bksy.prtr.laser='Y' gosub cp_set_laser
   close @bksyprtr_hndl
   ret

do_post_cp:
    if post_prg<>''
        ;there is a control file that needs to be executed here.  If
        ;post_prg_run='Y' then we need to run it, otherwise it's a
        ;EXEC prg.  In both cases we assume the program is in the
        ;Adv sub-directory.
        if post_prg_run='Y'
            chain bksy.prgs.whr*post_prg
        else
            exec bksy.prgs.whr*post_prg
        endif
        post_prg=''
        post_prg_run=''
    endif
    ret

cp_set_laser:
    ;in this case we need to reset the number of lines in the printer to 66
    laser_printer=.t.
    pchr '66lns' ptw p
    pset wdt 132 tlnes 66 plnes 66
    ret

#endp
;
::end of chse_prt udc
;
;******************************************************************************
;  get_date - get the date and time for reports
;******************************************************************************
:get_date
#proc
cmd get_date
    date_time_fld=mdy(date())+' '+ttoc(time(),7)
    date_time_fld=just(date_time_fld,'c')
    ret
#endp
;
:end of get_date udc
;
;
;******************************************************************************
;  fnc_list - list the possible function keys at the bottom of the screen
;             This routine will allow us to setup a standard proceedure
;             that can be used by all programs.
;******************************************************************************
:fnc_list
#proc
define fnc_list_fld type a size 120 local
define fnc_list_fld2 type A size 120 LOCAL
define fnc_list_esc,fnc_list_esc2 type a size 40 local
define fnc_clr_color type i local
cmd fnc_list fnc_list_fld,fnc_list_esc,fnc_list_fld2,fnc_list_esc2
    define save_list_fld,hold_list_fld type A size 120 LOCAL
    define save_list_fld2,hold_list_fld2 type A size 120 LOCAL
    define save_list_esc,hold_list_esc type A size 40 LOCAL
    if mid(up(fnc_list_fld),1,4) = "SAVE" DO
        save_list_fld = hold_list_fld
        save_list_fld2 = hold_list_fld2
        save_list_esc = hold_list_esc
        ret
    endif
    if up(fnc_list_fld) = "RESTORE" DO
        FNC_list_fld = SAVE_list_fld
        FNC_list_fld2 = save_list_fld2
        fnc_list_esc = save_list_esc
    endif
    hold_list_fld = fnc_list_fld
    hold_list_fld2 = fnc_list_fld2
    hold_list_esc = fnc_list_esc
   ;
   ;this routine is called with the field containing the function list in
   ;fnc_list_fld and the ESC info in fnc_list_esc.  This program will always
   ;start from the far left at the last line and will put the ESC info at the
   ;far right.
   ;
   define fnc_list_cntr,fnc_list_space type i local
   define fnc_list_hldr type a size 50 local
   ;define fnc_beg_chr type a size 1 local
   if fnc_clr_color = 0 THEN fnc_clr_color = norm_hldr
   if WINDOWS() GOTO BTN_LIST
   define fnc_front type I size 2
   fnc_front = 1
   ;clrlne at 1,24 abs color fnc_clr_color
   clrlne at 1,25 abs color fnc_clr_color
   fnc_list_cntr=1
   fnc_list_fld = dos_dach(fnc_list_fld)
   if SND_FNC_LNE_USD DO
       clrlne at 1,24 ABS color fnc_clr_color
       ? '' at 1,24 NOCR ABS
     SND_FNC_LNE_USD = .F.
   endif
   ? '' at 1,25 nocr abs
   while .t.
       fnc_list_hldr = gfld(fnc_list_cntr,,,fnc_list_fld)
      exit_if fnc_list_hldr=''
      if up(mid(fnc_list_hldr,1,3)) = 'UP-'  DO
         ;                  2                 1                 1
         ? C1(),''+trim(mid(fnc_list_hldr,loc('-',fNc_list_hldr),size(fnc_list_HLDR,'a')),'t'),CCF() NOCR ABS
      eLSE_if up(mid(fnc_list_hldr,1,3)) = 'DOW' DO
          ? C1(),''+trim(mid(fnc_list_hldr,loc('-',fnc_list_hldr),size(fnc_list_hldr,'a')),'t'),CCF() NOCR ABS
      else_if up(mid(fnc_list_hldr,1,3)) = 'CAR'
          ;FMZ 7/22/99 remove left arrow character for WIN compiler
          ? C1(),'ctrl<-'+trim(mid(fnc_list_hldr,loc('-',fnc_list_hldr),size(fnc_list_hldr,'a')),'t'),CCF() NOCR ABS
      else_if up(mid(fnc_list_hldr,1,3)) = 'CAL'
          ;FMZ 7/22/99 remove right arrow character for WIN compiler
          ? C1(),'ctrl->'+trim(mid(fnc_list_hldr,loc('-',fnc_list_hldr),size(fnc_list_hldr,'a')),'t'),CCF() NOCR ABS
      ELSE
      ? C1(),trim(fnc_list_hldr,'t'),CCF() NOCR ABS
      endif
      ? '³' color fnc_clr_color NOCR ABS
     inc fnc_list_cntr
    endw
   if fnc_list_fld2<>'' DO
       fnc_list_fld2 = dos_dach(fnc_list_fld2)
   fnc_list_cntr=1
   clrlne at 1,24 color fnc_clr_color
       ? '' at 1,24 NOCR ABS
       while .t.
           fnc_list_hldr = gfld(fnc_list_cntr,,,fnc_list_fld2)
           exit_if fnc_list_hldr=''
           ? C1(),trim(fnc_list_hldr,'t'),CCF() NOCR ABS
           ? '³' color fnc_clr_color NOCR ABS
           inc fnc_list_cntr
       endw
   endif
   ;
   ;now print the ESC info if any
   if fnc_list_esc<>''
      fnc_list_esc = dos_dach(fnc_list_esc)
      fnc_list_cntr = 1
      ;it does exist, do it.
      ? C1(),trim(gfld(fnc_list_cntr,,,fnc_list_esc),'t'),CCF() at 81-size(fnc_list_esc,'a'),25 NOCR ABS
      inc fnc_list_cntr
      while .t.
         fnc_list_hldr = gfld(fnc_list_cntr,,,fnc_list_esc)
         exit_if fnc_list_hldr=''
         ? '³' color fnc_clr_color NOCR ABS
         ? C1(),trim(fnc_list_hldr,'t'),CCF() NOCR ABS
         inc fnc_list_cntr
      endw
   endif
   ;
   ;now print the secondary ESC info if any
   ;
   if fnc_list_esc2<>''
       SND_FNC_LNE_USD = .T.
      fnc_list_esc2 = dos_dach(fnc_list_esc2)
      fnc_list_cntr = 1
      ;it does exist, do it.
      ? C1(),trim(gfld(fnc_list_cntr,,,fnc_list_esc2),'t'),CCF() at 81-size(fnc_list_esc2,'a'),24 NOCR ABS
      inc fnc_list_cntr
      while .t.
         fnc_list_hldr = gfld(fnc_list_cntr,,,fnc_list_esc2)
         exit_if fnc_list_hldr=''
         ? '³' color fnc_clr_color NOCR ABS
         ? C1(),trim(fnc_list_hldr,'t'),CCF() NOCR ABS
         inc fnc_list_cntr
      endw
   endif
   fnc_list_fld2=''
   fnc_list_esc2=''
   ret
BTN_LIST:
    define BTN.POS type R
    define BTN.KEY type A size 3
    scrn L
    BUTTON REMOVE
    BUTTON OFF
    if fnc_list_fld2 <> '' DO
        fnc_list_cntr = 1
        BTN.POS = 1
        while .T.
            fnc_list_hldr = gfld(fnc_list_cntr,,,fnc_list_fld2)
            exit_if fnc_list_hldr=''
            btn.key = mid(fnc_list_hldr,1,3)
            fnc_list_hldr = mid(fnc_list_hldr,loc(' ',fnc_list_hldr) + 1,size(fnc_list_hldr,'A'))
            button at BTN.POS,MAX_ROWS() - 3 len 2 wdt SIZE(FNC_LIST_HLDR,'A')+1 caption FNC_LIST_HLDR key SET_KEY(btn.key)
            BTN.POS = BTN.POS + (SIZE(FNC_LIST_HLDR,'A') + 1)
            inc fnc_list_cntr
        endw
    endif
    fnc_list_cntr = 1
    BTN.POS = 1
    while .T.
        fnc_list_hldr = gfld(fnc_list_cntr,,,fnc_list_fld)
        exit_if fnc_list_hldr=''
            btn.key = mid(fnc_list_hldr,1,3)
            fnc_list_hldr = mid(fnc_list_hldr,loc(' ',fnc_list_hldr) + 1,size(fnc_list_hldr,'A'))
            ;msg fnc_list_hldr + str(loc(' ',fnc_list_hldr))
            button at BTN.POS,MAX_ROWS() - 1 len 2 wdt SIZE(FNC_LIST_HLDR,'A')+1 caption FNC_LIST_HLDR key SET_KEY(btn.key)
        BTN.POS = BTN.POS + (SIZE(FNC_LIST_HLDR,'A') + 1)
        inc fnc_list_cntr
    endw
    if fnc_list_esc<>''
       define FNC_CNTR type I
       fnc_list_cntr = 1
       btn.pos = max_cols()
       while .T.
           fnc_list_hldr = gfld(fnc_list_cntr,,,fnc_list_esc)
           exit_if fnc_list_hldr=''
           fnc_list_hldr = mid(fnc_list_hldr,loc(' ',fnc_list_hldr) + 1,size(fnc_list_hldr,'A'))
           btn.pos = btn.pos - size(fnc_list_hldr,'a')
           inc fnc_list_cntr
       endw
       ;it does exist, do it.
       btn.pos=btn.pos-((fnc_list_cntr-2)*1)
       fnc_list_cntr = 1
       while .t.
          fnc_list_hldr = gfld(fnc_list_cntr,,,fnc_list_esc)
          exit_if fnc_list_hldr=''
          btn.key = mid(fnc_list_hldr,1,3)
          fnc_list_hldr = mid(fnc_list_hldr,loc(' ',fnc_list_hldr) + 1,size(fnc_list_hldr,'A'))
          button at BTN.POS,MAX_ROWS()-1 len 2 wdt SIZE(FNC_LIST_HLDR,'A')+1 caption FNC_LIST_HLDR key SET_KEY(btn.key)
          BTN.POS = BTN.POS + (SIZE(FNC_LIST_HLDR,'A') + 1)
          inc fnc_list_cntr
       endw
    endif
    ;now check for the secondary esc
    if fnc_list_esc2<>''
       fnc_list_cntr = 1
       ;BTN.POS = (MAX_COLS()+2) - (SIZE(FNC_LIST_ESC2,'A')+1)
       btn.pos = max_cols()
       while .T.
           fnc_list_hldr = gfld(fnc_list_cntr,,,fnc_list_esc2)
           exit_if fnc_list_hldr=''
           fnc_list_hldr = mid(fnc_list_hldr,loc(' ',fnc_list_hldr) + 1,size(fnc_list_hldr,'A'))
           btn.pos = btn.pos - size(fnc_list_hldr,'a')
           inc fnc_list_cntr
       endw
       ;it does exist, do it.
       btn.pos=btn.pos-((fnc_list_cntr-2)*1)
       fnc_list_cntr = 1
       while .t.
          fnc_list_hldr = gfld(fnc_list_cntr,,,fnc_list_esc2)
          exit_if fnc_list_hldr=''
          btn.key = mid(fnc_list_hldr,1,3)
          fnc_list_hldr = mid(fnc_list_hldr,loc(' ',fnc_list_hldr) + 1,size(fnc_list_hldr,'A'))
          button at BTN.POS,MAX_ROWS() - 3 len 2 wdt SIZE(FNC_LIST_HLDR,'A')+1 caption FNC_LIST_HLDR key SET_KEY(btn.key)
          BTN.POS = BTN.POS + (SIZE(FNC_LIST_HLDR,'A') + 1)
          inc fnc_list_cntr
       endw
    endif
    ;
    BUTTON ON
    scrn R
    fnc_list_fld2=''
    fnc_list_esc2=''
    ret

    define K.TYPE type A size 3
func SET_KEY K.TYPE
    K.TYPE = UP(K.TYPE)
    if K.TYPE = 'UP ' THEN ret 'UP'
    if K.TYPE = 'DOW' THEN ret 'DOWN'
    if K.TYPE = 'PGD' THEN ret 'PGDN'
    if K.TYPE = 'PGU' THEN ret 'PGUP'
    if K.TYPE = 'INS' THEN ret 'INSERT'
    if K.TYPE = 'DEL' THEN ret 'DELETE'
    if K.TYPE = 'HOM' THEN ret 'HOME'
    if K.TYPE = 'CAR' THEN ret 'WDRT'
    if K.TYPE = 'CAL' THEN ret 'WDLT'
    ret K.TYPE
    define func_list type A size 120
func DOS_DACH func_list
    define fpos type I
    define fpos2 type i
    fpos2 = 0
    while .t.
        ;msg func_list
        fpos = loc(' ',func_list,fpos2)
        exit_if fpos=0 .O. FPOS>=SIZE(FUNC_LIST,'A')
        func_list = mid(func_list,1,fpos-1)+'-'+mid(func_list,fpos+1,SIZE(FUNC_LIST,'D'))
        ;FMZ 6/28/98 Only put dash in first space.  After replacing a space,
        ;  then look for a comma starting with the position at which we
        ;  just replaced.
        fpos2 = loc(',',func_list,fpos)
        exit_if fpos2=0 .O. FPOS2>=SIZE(FUNC_LIST,'A')
        ;end FMZ 6/28/98
    endw
    ret func_list
#endp
;
::end of fnc_list func
;
;
;******************************************************************************
;  do_help - This is a generalized help routine that can be inserted into
;            any program.  Reads help messages from the BKHELP.B file.
;******************************************************************************
:do_help
#proc
define do_help_field type A size 17 LOCAL
define dh_lctr type I LOCAL
define bkhelp_hndl type I size 4
func do_help do_help_field
      ;display any help for the option if it is available
      do_help_field=up(do_help_field)
      ;if bkhelp_hndl=0
         ;the file hasn't been opened yet.
         openv 'bkfldhlp' fnum bkhelp_hndl type T ext 'B'
         if open()<>0
            msg 'There is no help file.'
            ret .t.
         endif
      ;endif
      findv M fnum bkhelp_hndl key hlp.key val do_help_field,1!
      if flerr(bkhelp_hndl)<>0
         msg 'There is no help available for this option.'
         ret .t.
      endif
      ;
      ;if we're here then help is available
      ;
      dh_lctr = val(gfld(1,,,hlp.line))
      saves
      window at 6,23-iif(dh_lctr<=10,dh_lctr,10) len iif(dh_lctr<=10,dh_lctr+2,12) wdt 66 wcolor err ttlw 'l' box 's' bcolor err shd 'r' scolor sc
      listf hlp.line file @bkhelp_hndl key hlp.key while hlp.code=do_help_field
      redsp
      ret .t.
#endp
;
::end of do_help proc
;
;******************************************************************************
;  get_help - This is similar to do_help above except it gets the records
;             from the BKHELP file and returns them in the MESSAGE array
;******************************************************************************
:get_help
#proc
define get_help_field type A size 17 LOCAL
define gh_lctr,gh_lctr2 type I LOCAL
define bkhelp_hndl type I size 5 LOCAL
define err_help type I size 1 LOCAL
func get_help get_help_field
    ;display any help for the option if it is available
    get_help_field = up(get_help_field)
    ;if bkhelp_hndl=0 DO
        ;the file hasn't been opened yet.
        openv 'bkfldhlp' fnum bkhelp_hndl type T ext 'B'
        if open()<>0 DO
            msg 'There is no help file.'
            ret .t.
        endif
    ;endif
    findv G fnum bkhelp_hndl key hlp.key val get_help_field
    if flerr(bkhelp_hndl)<>0 DO
        msg 'There is no help available for this option.'
        close @BKHELP_HNDL
        ret .t.
    endif
    ;
    ;if we're here then help is available
    ;
    gh_lctr2 = 0
    err_help = 0
    while hlp.code=get_help_field .a. err_help=0
        inc gh_lctr2
        message[gh_lctr2] = hlp.line
        findv N fnum bkhelp_hndl key hlp.key
        if flerr(bkhelp_hndl)<>0 DO
            err_help = 1
        endif
    endw
    NUM.MSG = GH_LCTR2
    LNE.LNGTH=0
    for(MCNTR;1;NUM.MSG;1)
        LNE.LN2=size(MESSAGE[MCNTR],'A')
        if LNE.LN2>LNE.LNGTH then LNE.LNGTH=LNE.LN2
    next
    NUM.MSG=NUM.MSG + 1
    if LNE.LNGTH<26 then LNE.LNGTH=26
    LNE.LNGTH=LNE.LNGTH + 4
    LLC=40 - (LNE.LNGTH / 2)
    HT=NUM.MSG + 3
    WD=LNE.LNGTH + 1
    saves3 1
    window at LLC,24-HT len HT+1 wdt WD+1 wcolor wc ttlw 'c' ttl ' Field Description ' box 's' bcolor bc shd 'r' scolor sc
    NUM.MSG=NUM.MSG - 1
    pmsg ""
    for(MCNTR;1;NUM.MSG;1)
        pmsg MESSAGE[MCNTR] at 3,row() ptw S
    next
    WD=(WD - 25) / 2
    pmsg "" ptw S
    pmsg "Press any key to continue" at WD,row() wait ptw S
    redsp3 1
    close @BKHELP_HNDL
    ret gh_lctr
    #endp
    ;
::end of get_help proc
;
;******************************************************************************
;  prg_hdr - this will print the first line at the top of the screen
;******************************************************************************
:prg_hdr
;
;Changed this routine to match Mike's Action Request of this
;date. 1/23/97 **pdm**
#proc
define prg_hdr_name type A size 70 LOCAL
cmd prg_hdr prg_hdr_name
define module type a size 2 local
   ;
   ;This routine will print the program header at the top of the screen.
   ;Called with the name to use and the color.  The balance is included
   ;in this routine.  The program expects a variable to be loaded by the
   ;name of current_ver which should be from the main menu.
   ;
   define prg_hdr_line type a size 80 local
   define prg_hdr_cv type a size 21 local
   PRG_HDR_LINE = ' '+PRG_HDR_NAME
   PROG.HELP.NAME = MID(PRG_HDR_NAME,1,LOC(' ',PRG_HDR_NAME))
   if .N. WINDOWS() DO
       module = mid(PRG_HDR_NAME,1,2)
       mid prg_hdr_line start 62 fld '    DBA Software    '
       if LOC(module,'GL-AR-AP-SO-SA-CS-CM-PR') > 0 THEN mid prg_hdr_line start 62 fld '    DBA Accounting'
       if LOC(MODULE,'IN-PO-BM-LW-LC-SC-FO-PI') >0 THEN mid prg_hdr_line start 62 fld '  DBA Distribution'
       if LOC(module,'RO-AW-JC-ES-MR-SH-DC') >0 THEN mid prg_hdr_line start 62 fld ' DBA Manufacturing'
       if LOC(module,'UT-MM-MD-AM-AD-PS-AI') >0 THEN mid prg_hdr_line start 62 fld 'DBA System Manager'
   endif
   if windows() DO
       caption prg_hdr_line
   else
       ? prg_hdr_line at 1,1 color rev NOCR ABS
   endif
   ret
#endp
;
::end of prg_hdr cmd
;
;
;******************************************************************************
;  ptd_list  - this will allow the user to send the output to the disk and then
;              access it automatically with a listf command when it's done.
;              This will give him/her the ability to search forward and
;              backward in the report.  Pages will be setup so that they print
;              one per screen.  Option is LIST when asked where to print.
;******************************************************************************
;
:ptd_list
#proc
define ptd_wch type a size 1 local
func ptd_list ptd_wch
    define ptd_on type l local
    define ptd_pfn type a size 11 local
    define ptd_hndl type i local
    define ptd_buff type a size 155 local
    if up(ptd_wch)='I'
        ;start the process, initialize the file.
        ptd_pfn=mid(ttoc(time()),1,11)
        mid ptd_pfn fld '_' start 3
        mid ptd_pfn fld '_' start 6
        while ffile(ptd_pfn,'f')<>''
            ;the file exists.  Try again.  All we need to do is stay
            ;in this loop and eventually, we'll get a file that doesn't
            ;exist.
            ptd_pfn=mid(ttoc(time()),1,11)
            mid ptd_pfn fld '_' start 3
            mid ptd_pfn fld '_' start 6
        endw
        ;when we get here we have a file name.
        ;first set the print to disk and file name
        pon d pfn ptd_pfn
        ;next set the print lines to 22
        ;pset plnes 22
        pset plnes 66
        ptd_on=.t.
        ret .t.
    else
        ;in this case we're ready to list the report
        clspf       && close the print to disk file.
        pset pwhr 's'
        if .n. ptd_on then ret .f.
        saves
        openv ptd_pfn type x size 150 buff ptd_buff fnum ptd_hndl
        window at 1,1 len 24 wdt 80 box 's' ttlw 'l' ttl ' Report Listing '
        fnc_list 'UseÿArrowÿKeys,PageÿUp,PageÿDown,End,Home,OrÿMouse','EscÿExit',"",''
        ;listf ptd_fchr(),mid(ptd_buff,31,30),mid(ptd_buff,61,30),mid(ptd_buff,91,42) file @ptd_hndl ccolor 255
        listf ptd_fchr(),mid(ptd_buff,31,30),mid(ptd_buff,61,30),mid(ptd_buff,91,42) file @ptd_hndl ccolor norm
        ;
        ;when we get here the user is finished.
        ;
        close @ptd_hndl
        delf ptd_pfn
        redsp
        ptd_on=.f.
        ret .t.
    endif
    ;we'll never get here.

    func ptd_fchr
        if mid(ptd_buff,1,1)=chr(12)
            delc ptd_buff start 1 nchr 1
        else_if asc(mid(ptd_buff,1,1))<32
            ptd_buff=''
            ret ''
        endif
        ret mid(ptd_buff,1,30)
#endp
;
::ptd_list end
:FILE_LIST
#PROC
define FILE_NAME type A size 12 UP LOCAL
CMD FILE_LIST FILE_NAME
    define FILE_hndl type I LOCAL
    define FILE_buff type A size 5000 LOCAL
        saves
        if windows() DO
            openv FILE_NAME fnum FILE_hndl type X size 255 buff FILE_buff
        else
            openv FILE_NAME fnum FILE_hndl type X size 5000 buff FILE_buff
        endif
        clrscr
        fnc_list "","ESC Exit"
        pmsg 'UseÿArrowÿKeys, PageÿUp, PageÿDown, End, or Home to view the file' at 5,24
        window at 1,1 len 23 wdt 80 ttlw 'l' ttl ' Listing '+ FILE_NAME box 'N'
        listf MID(FILE_BUFF,1,60),mid(FILE_buff,61,60),mid(FILE_buff,121,60),mid(FILE_buff,181,60),MID(FILE_BUFF,241,60),MID(FILE_BUFF,301,60),MID(FILE_BUFF,361,60),MID(FILE_BUFF,421,60),IIF(MID(FILE_BUFF,422,1)<>'','+','') file @FILE_hndl ccolor norm
        ;when we get here the user is finished.
        ;
        close @FILE_hndl
        redsp
        ret
#ENDP
:: FILE_LIST
;
;******************************************************************************
;  prtr_setup - Setup the options for each print type.
;******************************************************************************
;FMZ 5/29/98 Added a new variable, PRT_COND_MODE, so calling program will
;  know if user indicated to print condensed or not.
;
:prtr_setup
#proc
define prtr_wch type a size 1 local
define prt_cond_mode type a size 1
cmd prtr_setup prtr_wch
    ;trace STEP brk BREAK_ROUTINE
    ;this assumes that the program has already executed the MOUNT command.
    define pl_shldr_on type l local
    define prtr_where,prtr_width type a size 1 local
    prtr_wch=up(prtr_wch)
    if prtr_wch='N' .o. prtr_wch='W'
        ;initial setup for narrow (N) or wide (W) reports
        prt_cond_mode = 'N'
        pl_shldr_on=.f.                     && init the save screen flag
        prtr_where=pwhr()                   && save the pwhr() value for later
        prtr_width=prtr_wch                 && save the size of the report
        ;if pwhr()='S' .a. prtr_wch='N'
            ;Narrow format and to the screen
            ;window at 1,1 len 22 wdt 80
        ;else_if pwhr()='L'
        if pwhr()='L' .o. pwhr()='S' DO && ZLD 5/4/00 fixing spacing around .o.
            ;format size doesn't matter here, this is a list option.
            ;Initialize the list.
            prtr_where = 'L'   ;save the pwhr() value for later
            dummy_l=ptd_list('i')
        else_if pwhr()='P'
            ;ditto to format size, printer option.  However, if prtr_wch='W'
            ;then we need to ask whether or not to print condensed.
            if .n. windows() then chse_prt && ZLD 5/4/00 fixing spacing around .n.
            if prtr_wch='W'
                ;wide option, ask if user wants to print condensed.
                ask 'Print in condensed mode? [Y/N] Y'
                if ask()
                   pchr 'pcmp'
                   prt_cond_mode = 'Y'
                endif
            endif
            pchr 'init'             && init in either case
        else   ;this is add to remove the screen by gws
            window at 1,1 len 22 wdt 80
        endif
        ;
        ;if we're not going to the screen there's a couple other things we need
        ;to do.  Also, we need to reset the wdt value if prtr_wch='W'
        ;
        if pwhr()<>'S'
            ;setup the print line info on the screen
            define pl_shldr type a size 4200 local
            saves pl_shldr
            scrn R
            pl_shldr_on=.t.    && set the flag
            window at 29,11 box 's' len 3 wdt 22 wcolor wc bcolor bc shd 'r' scolor sc
            ? ' Print Line: ' ptw s at 1,1 nocr
            show_pline 15,1
        endif
        ;
        ;reset the number of lines per page to work in both windows and dos
        ;
        ;if prtr_wch='W' then pset wdt 132
        ;
        if pwhr()='P'
            if prtr_wch='W'
                pset wdt 132 tlnes 66 plnes 59
            else
                pset wdt 80 tlnes 66 plnes 59
            endif
        else
            ;make sure the printer width is set to 132 if we're not printing
            ;to the printer and this is a wide report.  This will make sure
            ;that wide reports are printed properly when printing to disk and
            ;list
            if prtr_wch='W' .a. pwhr()<>'S' then pset wdt 132
        endif
        ret
    else
        ;in this case we should be at the end of the report.  Again figure out
        ;where we were going and do appropriate resets.
        ;if prtr_where<>'S' .a. pl_shldr_on
        if pl_shldr_on DO
            ;screen has been saved previously, redisplay it.
            redsp pl_shldr
            pl_shldr_on=.f.
        endif
        trap pg_brk dflt
        if (prtr_width='N' .o. prtr_where<>'S') .a. iif(prtr_where='S',.n. esc(),.t.) .a. \
            iif(prtr_where='P'.o. prtr_where='D',prow()<>1 .o. pcol()<>1,.t.)
            ;if the report was narrow then do a ptof for all, otherwise only
            ;do one for non-screen outputs.  NOTE:  Don't do ptof if printing
            ;to screen and the user presses the ESC key.
            if .n. Windows() then ptof
        endif
        if prtr_where='L'
            ;this is a list output, go do it.
            dummy_l=ptd_list('d')
            pset plnes 66       && reset the printable lines value.
        else_if prtr_where='P'
            ;if going to printer and width='W' (wide) then reset to regular size
            pchr 'preg'
            if laser_printer
                ;we need to undo what we did before
                pchr '60lns' ptw p
                laser_printer=.f.
            endif
            ;we also need to check for a post prg.  This is run after the
            ;printing is complete and may be necessary to reset a lan printer
            ;path, reset a printer, etc.
            gosub   do_post_cp
            ;and we're done.
            exec 'bktof'                ;force the spooler to close.  Also,
                                        ;on some computers we have found they
                                        ;need a real file, can't just do '  '
        endif
        ;
        ;in all cases reset the whr and wdt values to S and 80.  It won't
        ;effect screen output and it will take care of all others.
        ;
        pset wdt 80 pwhr 's'
        ;
        ;and we're done.
        ;
        ret
    endif
    ret     && just in case, normally we shouldn't get here.
#endp
;
::prtr_setup end
;
;******************************************************************************
;  ask_update - This will ask the user whether or not they want to save a
;               record that has changed before clearing it.  This would occur
;               when finding a different one, actually clearing it, or escaping
;               from the program (closing the file).
;******************************************************************************
:ask_update
#proc
define ask_update_fn type a size 8 local
func ask_update ask_update_fn
    message[1]=' You have changed field(s) in a record in the file: '+ask_update_fn
    message[2]=' Do you wish to save this record before continuing? '
    if ent_list(msg_ptr,2,'Y','YN')='Y'
        ret .t.
    else
        ret .f.
    endif
#endp
;
::ask_update end
;
;**************************************************************************
;  sel_prtr - This function display the printers from file bkprtcfg
;             and return the selection number from the array
;
:sel_prtr
#proc
define cfg_cntr,cfg_cntrl,cfg_hndl type i local
func sel_prtr
    openv 'bkprtcfg' fnum cfg_hndl type T ext 'B'
    findv F fnum cfg_hndl key @0
    cfg_cntrl = 0
    if bkprt.cfg.name[1]='' DO
        close @CFG_HNDL
        ret CFG_CNTRL
    endif
    for(CFG_CNTR;1;10;1)
        fexit_if bkprt.cfg.name[cfg_cntr]=''
    next
    dec cfg_cntr
    if cfg_cntr>1 DO
        saves
        window at 25,23-cfg_cntr len cfg_cntr + 2 wdt 30 wcolor wc ttlw 'l' ttl 'Choose Printer' box 's' bcolor bc shd 'r' scolor sc
        listm bkprt.cfg.name actv cfg_cntr maxa 10 cntr cfg_cntrl
        redsp
        if cfg_cntrl=0 THEN ret CFG_CNTRL
        else
            cfg_cntrl = 1
        endif
        close @CFG_HNDL
        ret CFG_CNTRL
#endp
::sel_prtr end
;
;******************************************************************************
;  inc_date - increment the month or year in a date field.
;******************************************************************************
:inc_date
;modified 12/26/94 to allow for inc and dec to a date by setting the value of
;the inc_date_amt to positive or negative.
#proc
define inc_date_date type d local
define inc_date_amt type n local
define inc_date_wch type a size 1 local
func inc_date inc_date_wch,inc_date_date,inc_date_amt
   ;
   define inc_date_day type b local
   define inc_date_month type b local
   define inc_date_year type i local
   ;
   define inc_day_num,inc_month_num,inc_year_num type n size 10
   ;
   define inc_date_maxd type b array 12 local
   if inc_date_maxd[1]=0
      ;setup the maximum days per month
      inc_date_maxd[1]=31 | inc_date_maxd[2]=28 | inc_date_maxd[3]=31
      inc_date_maxd[4]=30 | inc_date_maxd[5]=31 | inc_date_maxd[6]=30
      inc_date_maxd[7]=31 | inc_date_maxd[8]=31 | inc_date_maxd[9]=30
      inc_date_maxd[10]=31 | inc_date_maxd[11]=30 | inc_date_maxd[12]=31
   endif
   ;
   ;move the date into the separate fields
   ;
   xfer from inc_date_date to inc_date_day nchr 4
   inc_day_num=inc_date_day
   inc_month_num=inc_date_month
   inc_year_num=inc_date_year
   ;
   ;now determine what we need to increment
   ;
   if up(inc_date_wch)='M'
      ;increment the month
      inc_month_num=inc_month_num+inc_date_amt
      while .t.
         exit_if inc_month_num<=12 .a. inc_month_num>0
         if inc_month_num>0
            ;adding to date
            inc_year_num=inc_year_num+1
            inc_month_num=inc_month_num-12
         else
            ;subtracting from date
            inc_year_num=inc_year_num-1
            inc_month_num=inc_month_num+12
         endif
      endw
      ;check for leap years
      if int(inc_year_num/4)*4=inc_year_num then inc_date_maxd[2]=29
      ;
      ;AJF 3/12/99
      ;if inc_date_maxd[inc_month_num]<inc_day_num then inc_day_num=inc_date_maxd[inc_date_month]
       if inc_date_maxd[inc_month_num]<inc_day_num then inc_day_num=inc_date_maxd[inc_month_num]
      ;
   else_if up(inc_date_wch)='Y'
      ;increment the year
      inc_year_num=inc_year_num+inc_date_amt
   endif
   inc_date_day=inc_day_num
   inc_date_month=inc_month_num
   inc_date_year=inc_year_num
   xfer from inc_date_day to inc_date_date nchr 4
   ret inc_date_date
#endp
;
::end of inc_date func
;
;
;******************************************************************************
;  xtrap_si_udc and xtrap_rstr_udc
;******************************************************************************
:xtrap_si_udc
#proc

define button_list type r array 20
define button_cntr type i

cmd xtrap_si_udc
    ;this udc will do the standard XTRAP SAVE IGNR but will also reset the
    ;F1 trap so that it will be set properly.
    xtrap save ignr
    ;trap F1 GOSUB SHOWHELP  AJF 4/1/99 remove
    ;now do the button save stuff
    if windows() then xbtn_save
    ret

    cmd xbtn_save
        if button_cntr = 20
            message[1] = 'Too many XBTN_SAVEs without any XBTN_RSTRs'
            msg_list msg_ptr,1
            ret
        endif
        inc button_cntr
        button save_to button_list[button_cntr] off
        ret

#endp
;
::end of xtrap_si_udc
;
;******************************************************************************
;  xtrap_rstr_udc
;******************************************************************************
:xtrap_rstr_udc
#proc
cmd xtrap_rstr_udc
    if windows() then xbtn_rstr
    xtrap rstr
    ret

    cmd xbtn_rstr
        if button_cntr = 0
            message[1] = 'Too many XBTN_RSTRs without equal XBTN_SAVEs'
            msg_list msg_ptr,1
            ret
        endif
        button rstr_from button_list[button_cntr] on
        dec button_cntr
        ret
#endp
;
::end of xtrap_rstr_udc
;
;
;
;******************************************************************************
;  func coo - return whether or not the check_open_only flag is set.
;******************************************************************************
:coo
#proc
define coo_test type l local
func coo coo_test
    if coo_test .a. check_open_only then ret .f.
    ret .t.
#endp
;
::end of coo
;
;******************************************************************************
;  cmd ask_coo - ask the check_open_only question
;******************************************************************************
:ask_coo
#proc
define check_open_only type l
define ask_string type a size 50 local
cmd ask_coo ask_string
    ask ask_string*' Y'
    check_open_only = ask()
    ret
#endp
;
::end of ask_coo
;
;******************************************************************************
;  chk_fiscal_fnc - check the fiscal date for a program.
;
;                   Parameter 1 is the date to be checked.
;                   Parameter 2 is optional, 0 or 1.  0 means that
;                     messaging withing this function is enabled, 1 means
;                     that all messaging is disabled.  If only the date is
;                     passed, and no 2nd parameter, then messaging will by
;                     default be enabled.
;                     Basically, messaging should usually be enabled if
;                     this function being called to validate an entry
;                     field, disabled if being called as part of some
;                     non-entry procedure that you do not want interrupted
;                     by messages.
;
;                   This function uses BAD_FISCAL() and ASK_PRIOR() for its
;                     messaging.  Both of these functions can also be
;                     called independently of CHK_FISCAL_FNC() by other
;                     programs.
;
;                   This function uses GET.GLYEAR() to determine which FY
;                     the date is in.  GET.GLYEAR() can also be called
;                     independently of CHK_FISCAL_FNC() by other programs.
;
;                   FMZ 03/08/02 For stand-alone: This function now checks
;                     to see if Acctg is ON.  If not, this function always
;                     returns T (allowing any posting date without
;                     checking FY).  This means that the program calling
;                     this function MUST have previously called the
;                     What's On function, which sets the sysAcctgON variable.
;
;                   CHK_FISCAL_FNC() returns T if date can be posted
;                     to the GL (current FY or 1YP, 2YP), F otherwise.
;
;       This assumes you have the BKSYMSTR record active in memory.
;******************************************************************************
:chk_fiscal_fnc
#proc
define chk_fisc_date type d local
define chk_fisc_msg  type i size 1 local
define chkf.ret      type l local
define chkf.fynum    type i size 1 local

func chk_fiscal_fnc chk_fisc_date, chk_fisc_msg

   ;FMZ 03/08/02 Stand-alone: If Acctg is OFF, do not check FY date -
   ;  allow any trxn date regardless of FY.
   if sysAcctgOn=.f.
      ;FMZ 05/13/02 Crap. The problem with just returning T here if
      ;  GL is off is that now a date of 00/00/00 would be considered
      ;  valid, which we generally do not want.  Since in the past GL
      ;  was always on for all users, a date of 00/00/00 was always
      ;  getting rejected.  So will preserve that here for the users
      ;  who have GL off.
      if chk_fisc_date=0
         ;The date entered is blank.  Give warning and abort display of any
         ;  other validation message by the calling program.
         if chk_fisc_msg = 0
            msg 'The date is not valid (00/00/00). ' windows 'w'
            novldmsg
         else
            ;In all cases, resetting the message flag to 0 to ensure that any
            ;  later call to this function by the same program won't
            ;  accidentally have a non-zero value for this flag.  Probably
            ;  do not have to do this due to it being a local variable but
            ;  not sure.
            chk_fisc_msg = 0
         endif
         ret .f.
      endif

      ret .t.
   endif

   ;Determine which FY the date is in.
   chkf.fynum = get.glyear(chk_fisc_date)


   ;AJF 4/15/00 - handle a future year situation - per MH, no message
   ;              needs to be provided to the user regardless of the
   ;              relation of the system date to the fiscal year end
   if chkf.fynum = 8
      ret .t.
   endif

   if chkf.fynum = 9
      ;The date entered is either beyond the current fiscal year or
      ;  more than 2 years ago.  Give warning and abort display of any
      ;  other validation message by the calling program.
      if chk_fisc_msg = 0
         chkf.ret = bad_fiscal()
         novldmsg
      else
         ;In all cases, resetting the message flag to 0 to ensure that any
         ;  later call to this function by the same program won't
         ;  accidentally have a non-zero value for this flag.  Probably
         ;  do not have to do this due to it being a local variable but
         ;  not sure.
         chk_fisc_msg = 0
      endif
      ret .f.
   endif


   ;Warn if this will be a prior-year posting.
   if chkf.fynum = 0
   else
      if chk_fisc_msg = 0
         chkf.ret = ask_prior()
         if chkf.ret = .f.
            novldmsg
         endif
         ret chkf.ret
      endif
   endif

   chk_fisc_msg = 0
   ret .t.

func bad_fiscal
   ;this will print the bad_fiscal date message
   if windows()

      ;AJF 4/15/00 add clarifying info. that posting can occur in the year following
      msg "A transaction with this date cannot be posted to the GL."  \
        +chr(13)+chr(13)+ \
        "The transaction date must be in the current fiscal year, \
         or in the fiscal year immediately following, \
         or in one of the two preceding fiscal years." \
        +chr(13)+chr(13)+ \
        "The starting date of the current fiscal year is "+ \
        dtoc(BKSY.FISCAL.YR)+ ". " windows 'warn'
   else
      ;AJF 4/15/00 add clarifying info. that posting can occur in the year following
      msg "A transaction with this date cannot be posted to the GL.  The \
           transaction date must be in the current fiscal year, \
           or in the fiscal year immediately following, \
           or in one of the two preceding fiscal years.  The \
           starting date of the current fiscal year is "+ \
           dtoc(BKSY.FISCAL.YR)+ ". " windows 'warn'
   endif
   ret .t.

define askpfy.ret type l local
func ask_prior
   ;this prompts user if date is for a prior FY
   askpfy.ret = zask('This transaction will be posted to a prior fiscal year.  Is this OK? ', .t.)
   ret askpfy.ret

;
#endp
::end of chk_fiscal_fnc routine

;******************************************************************************
;  chk_glclose - check the GL close date for a program.
;
;                   Parameter 1 is the date to be checked.
;                   Parameter 2 is optional, 0 or 1.  0 means that
;                     messaging withing this function is enabled, 1 means
;                     that all messaging is disabled.  If only the date is
;                     passed, and no 2nd parameter, then messaging will by
;                     default be enabled.
;                     Basically, messaging should usually be enabled if
;                     this function being called to validate an entry
;                     field, disabled if being called as part of some
;                     non-entry procedure that you do not want interrupted
;                     by messages.
;
;                   This function uses BAD_GLCLOSE() for its
;                     messaging.  That function can also be
;                     called independently of CHK_GLCLOSE() by other
;                     programs.
;
;                   CHK_GLCLOSE() returns T if date is later than
;                     to the GL close date in AD-B, F otherwise.
;
;       This assumes you have the BKYSMSTR record active in memory.
;******************************************************************************
:chk_glclose
#proc
define chk_glc_date type d local
define chk_glc_msg  type i size 1 local
define chkg.ret     type l local

func chk_glclose chk_glc_date, chk_glc_msg

    if chk_glc_date < BKYS.DATE[1]
       ;Invalid date
       if chk_glc_msg = 0
          chkg.ret = bad_glclose()
          novldmsg
       endif
       chk_glc_msg = 0
       ret .f.
    endif

    chk_glc_msg = 0
    ret .t.

func bad_glclose
   ;this will print the bad_glclose date message
   msg "The transaction date is prior to the Period-End Close Date. " windows 'warn'
   ret .t.
;
#endp
::end of chk_glclose routine

;******************************************************************************
;  get.glyear - You pass it a date, this returns an i,1 value indicating
;               which GL fiscal year that date is in:
;               0 = current
;               1 = 1 year past
;               2 = 2 years past
;               8 = next year, i.e. year immediately following the current year
;               9 = more than 2 years past, or after the end of the
;                   current FY
;               Assumes the BKSYMSTR record is active in memory.
;******************************************************************************
:get.glyear
#proc
define get.glyparam type d size 8 local
define get.glyret type i size 1 local
func get.glyear get.glyparam

   if sysAcctgOn=.f.
      ;FMZ 05/12/02 Always return 0 if GL is OFF (since we don't have
      ;  a FY in this case, then any date is considered to be in the
      ;  "current" FY).
      ;FMZ 05/13/02 Crappola.  This has same issue as FY checker above,
      ;  for some programs needs to reject date if it is 00/00/00.
      if get.glyparam=0
         ;reject blank date
         get.glyret=9
      else
         ;accept any non-blank date
         get.glyret=0
      endif
   else

      ;AJF 4/15/00 we are now allowing the user to input a date
      ;            that is one year into the future
      ;            so change the number of years to add from 1 to 2
      if get.glyparam >= inc_date('Y',BKSY.FISCAL.YR,2) .o. \
         get.glyparam < inc_date('Y',bksy.fiscal.yr,-2)
         ;the date entered is either beyond the year after the
         ;current fiscal year or more than 2 years ago.
         get.glyret = 9
      else
 
         ;AJF 4/15/00 - handle next year
         if get.glyparam >= inc_date('Y',BKSY.FISCAL.YR,1)
            get.glyret=8
         else_if get.glyparam >= BKSY.FISCAL.YR
            get.glyret=0
         else_if get.glyparam >= inc_date('Y',BKSY.FISCAL.YR,-1)
            get.glyret=1
         else
            get.glyret=2
         endif
      endif
   endif

   ret get.glyret
;
#endp
::end of get.glyear routine


;******************************************************************************
;  zask() - To ask a YN question w/o allowing ESC in DOS
;           (WIN already does not allow ESC)
;******************************************************************************
:zask
#proc
define za_text type a size 500 local
define za_dflt type l local
func zask za_text, za_dflt
   if windows()
      ask za_text dflt za_dflt
      ret ask()
   else
      if za_dflt = .t.
         za_text = za_text * ' Y'
      else
         za_text = za_text * ' N'
      endif
      ;
      while .t.
         ask za_text dflt za_dflt
         if lstchr() = 283
            bell
         else
            exit
         endif
      endw
      ret ask()
   endif
#endp
::end of zask routine
;
;******************************************************************************
;  vld.chkact -  Validates the checking accounts set up in BKSYMSTR (1-9).
;           Returns .t. if at least one valid checking account is set up,
;             .f. otherwise.
;           Make sure BKSYMSTR is already open in the calling
;             program.
;      -->  This function presumes BKSYMSTR is open and on the first
;             record; does not attempt a FIND.
;           No passed parameters.
;******************************************************************************
;FMZ 05/02/02 No more GLCOA validation here.  Also, always returns T now
;             if GL is off (no bank accts so nothing to validate).
:vld.chkact
#proc
define vck.cntr1, vck.cntr2 type i size 5 local
define vck.glrec type r size 10 local
func vld.chkact
    if sysAcctgOn=.f.
       ret .t.
    endif

    xtrap_si_udc
    vck.cntr1 = 0
    for(vck.cntr2;1;9;1)
      ;We would only get in here if GL is on, thus we can also validate
      ;  that each bank acct also has a GL set up.
      if BKSY.CHK.NAME[vck.cntr2]<>""
         if BKSY.CHK.CHKACT[vck.cntr2]=""
            msg 'Warning: Checking account "'+BKSY.CHK.NAME[vck.cntr2]*'" does not have a GL account assigned to it and will not be available for selection.  Please use the "Checking Accounts Defaults" menu selection to correct this. ' windows 'warn'
         else
            vck.cntr1 = vck.cntr1 + 1
         endif
      endif
    next
    if vck.cntr1 = 0
       msg 'Warning: Checking accounts have not yet been defined.  Please use the "Checking Accounts Defaults" menu selection to set up at least one checking account. ' windows 'warn'
       xtrap_rstr_udc
       ret .f.
    else
       xtrap_rstr_udc
       ret .t.
    endif
#endp
::end of vld.chkact routine
;
;******************************************************************************
;  sel.chkact -  Lets user choose one of the checking accounts set up
;                  in BKSYMSTR (1-9).
;           Returns an i,2 variable designating the selected account.
;           If no account selected, returns 0.
;      -->  Make sure BKSYMSTR is already open in the calling
;             program.
;      -->  This function presumes BKSYMSTR is open and on the first
;             record; does not attempt a FIND.
;           Passed parameters: SCK.DFLT.ACT (i,2) representing which bank
;             account (1-9) to use as the default selection.  Also can
;             pass the 2 coordinates for top left corner of display.
;******************************************************************************
;FMZ 05/02/02 No more GLCOA validation here.  Also, always returns 1 as
;             the "chosen" bank acct if there are no bank accts (ie if
;             GL is off).
:sel.chkact
#proc
define sck.dflt.act type i size 2
define sck.chk.act type i size 2 local
define sck.chk.arr type a size 36 array 9 local
define sck.tot, sck.cntr type i size 5 local
define sck.glrec type r size 10 local
define sck.sel.txt type a size 2 local
define sck.sel.num type n size 2 dec 0 local
define sck.row, sck.col type i size 2 local
define sck.noesc type l local
func sel.chkact sck.dflt.act, sck.col, sck.row, sck.noesc
  if sysAcctgOn=.f.
     ;GL is off so no bank accts, always return 1.
     sck.chk.act=1
     ret sck.chk.act
  endif

  xtrap_si_udc

  if sck.row = 0 then sck.row = 8
  if sck.col = 0 then sck.col = 21

  ;First, validate the checking accounts and, if there are no valid
  ;  accounts, return to calling program.
  if vld.chkact() = .f.
     sck.chk.act = 0
     xtrap_rstr_udc
     ret sck.chk.act
  endif

  ;Load all valid checking accts into selection array.
  updta sck.chk.arr clr
  sck.tot = 0
  for(sck.cntr;1;9;1)
    ;Only get here now if have bank accts (ie GL is on) so can require
    ;  each bank acct to have a GL.
    if BKSY.CHK.NAME[sck.cntr]<>"" .a. BKSY.CHK.CHKACT[sck.cntr]<>""
       sck.tot = sck.tot + 1
       sck.chk.arr[sck.tot]=' '+str(sck.cntr,1,0)+' - '+BKSY.CHK.NAME[sck.cntr]+' '
       ;Check for default setting.  If this is the default acct, may
       ;  need to renumber it.
       if sck.dflt.act <> 0
          if sck.cntr = sck.dflt.act
             sck.dflt.act = sck.tot
          endif
       endif
    endif
  next

  ;And let them select.  If they ESC, sck.sel.act will be 0.
  SCK.SEL.ACT:
    if sck.dflt.act = 0
       sck.chk.act = 1
    else
       sck.chk.act = sck.dflt.act
    endif
    nmenu sck.chk.arr at sck.col,sck.row len sck.tot+2 wdt 38 \
          cntr sck.chk.act nch sck.tot box 's' \
          bcolor bc mcolor mc ccolor cc shd 'r' scolor sc \
          ttlw 'l' ttl " Select Bank Account " ARRAY AUTO NO_ESC sck.noesc

  if sck.chk.act = 0
     ;ESC'd from selection process.
     if .n. zask("The process you are running may not be able to continue if you don't choose a bank account.  Exit without selecting a bank account?", .f.)
        goto SCK.SEL.ACT
     endif
  else
     ;Have to 'translate' the account number back in case there are
     ;  invalid acounts in between valid ones.
     sck.sel.txt = mid(sck.chk.arr[sck.chk.act],1,2)
     sck.sel.num = val(sck.sel.txt)
     sck.chk.act = sck.sel.num
  endif

  xtrap_rstr_udc
  ret sck.chk.act
#endp
::end of sel.chkact routine
;**************** stat_bar command ********************** 5/28/99
:stat_bar
#proc
define col,row type i size 2
define current, howmany type n size 6
define percent type i size 3
define menu_title type a size 3
define done type a size 3
define z,z1 type i size 1
define x type n size 3

cmd stat_bar col, row, current, howmany, done

;6/1/99 AjM  clearing of the stat bar.
 if up(done) = 'CLR'
   ;6/6/00 AJF - increased pmsg by 2 spaces 
  
   pmsg '                               ' at col+1,row+1      
   pbox s at col,row len 3 wdt 33 color get_win_color('normalbkg') clr 
 else 
   percent = (current / howmany) *100  
   menu_title = str(percent)  
   ;window at col,row len 3 wdt 27
   if current < 5
      pmsg '                           ' at col+1,row+1      
   endif
   pbox s at col,row len 3 wdt 33 color get_win_color('normaltext') 
   x = percent
   z = percent / 4
   z1 = 1    
   pmsg ' '+menu_title + '% ' at col + 27,row+1
   if percent > 3
     for(z1;1;z;1) && ZLD 5/10/00 remove space between for and (   
       pmsg cc(get_win_color('yellow')) + chr(219) at col+ 1 + z1,row+1 nocr
     next
   endif

  ;6/1/99 adding mod-4 condition.
   if (mod(x,4) <> 0)
      if (mod(x,4) = 3)
         pmsg chr(176) at col+z1+1,row+1 nocr ;°
      else_if (mod(x,4) = 2)
         pmsg chr(177) at col+z1+1,row+1 nocr ;±
      else_if (mod(x,4) = 1)
         pmsg chr(178) at col+z1+1,row+1 nocr ;²
      endif
   endif


 
   pbox s at col,row len 3 wdt 33 color get_win_color('normaltext') 
 endif
ret 
::stat_bar
;2/23/00 new functions
;********************** add_slash *************
; This is used for putting the backslash at the end of an alpha field
; for uses with pathing and whatever.
;********************************************
:add_slash
#proc
define pass_path type a size 66
define wherespace type i size 2
define zcount type i size 2
func add_slash pass_path
   for(zcount;1;66;1)
      if mid(pass_path,zcount,1) = ""
         wherespace = zcount
         fexit
      endif
   next
   ;if the path is blank and we add a slash instead of the curr directory
   ; we will end up in the root of the current drive.
   if mid(pass_path,wherespace-1,1) <> '\'
      pass_path = pass_path*'\' && just defaulting backslash. 2/23/00
   endif
ret pass_path
#endp
::add_slash
;
;********************** Valid_dir *******************************************
;  This will to check if the path passed to it is a valid path
;             parameters:   pass_path - this is the string of the path
;                                       you would like to check.
;        NOTE:  assumption is that you have used add_slash BEFORE
;               calling this function
;        Added 2/24/00      createdir - This will give you the option
;                                       to create the directory if it is not
;                                       there to begin with.
;                                       1 - check path, create directory,
;                                           check path again.
;                                       0 - just check path.
;
;        Add 3/21/00        msg_on      1 - messaging is on
;                                       0 - messaging is off - handle by program
;****************************************************************************
:valid_dir
#proc
define pass_path type a size 66
define temp_path type a size 66
define test_hndl type i size 5
define test_buff type a size 60
define createdir type i size 1
define msg_on type I size 1
func valid_dir pass_path, createdir, msg_on
   openv pass_path*'testpath.txt' type X fnum test_hndl buff test_buff size 60 create err no_good
   ;if we make it here it's a valid path.
   close @test_hndl
   delf pass_path*'testpath.txt' && 3/21/00 added testpath.txt
   ret .t.   
  no_good:
   if createdir = 1
      temp_path = mid(pass_path,1,lchr(pass_path,'l')-1)
      if windows()
         if .n. make_dir(temp_path)
            if msg_on=1 then msg 'Unable to make subdirectory - '+pass_path
            ret .f.
         endif
      else
         exec 'md '+temp_path*' >nul'
      endif
      ret valid_dir(pass_path,0)
   endif
   if msg_on=1 then msg 'This subdirectory is invalid! ' windows 'w'
ret .f.
#endp
::valid_dir
;3/15/00 AjM------------------------------------------------
;3/17/00-3/18/00 Combining all into one function with a passed parameter.
;04/04/00 FMZ Minor change to these 3 functions.  We actually need a third
;             error message in sys_file_lock, for when attempting a file
;             lock but that is NOT coming from one of the default
;             settings programs (since in this case the wording about
;             "you can view these settings but not change them" would make
;             no sense.  So the MSG_TYPE parameter that gets passed to
;             the 2 OPEN functions should now only be a 1 if the calling
;             program is a default settings program, 0 in all other cases.
;             And we now pass the lock type parameter to sys_file_lock so
;             it can distinguish an F attempt from R or N and choose the
;             right message.
;**********************************************************************
;    open_symstr: pass a "R" an "N" or a "F" to determine the lock
;    open_ysmstr: on the file.  case will not matter.
;                 second parameter.  msg type will determine which
;                 message is called when you cannot open the file with
;                 a higher lock.
;    Example: if .n. open_symstr('N') then quit
;             if .n. open_symstr('F',1) then quit
;             if .n. open_ysmstr('N') then quit
;             if .n. open_ysmstr('R') then quit
;**********************************************************************
:open_symstr
define bksymstr_hndl type i size 5
#proc
define xret type l local
define lock_type type a size 1 local
define msg_type type i size 1 local
func open_symstr lock_type,msg_type
   lock_type = up(lock_type) && force to upcase.
   if lock_type $ "RN"
      trap rlck goto sy_locked_n
      if lock_type = "N"
         openv 'BKSYMSTR' fnum bksymstr_hndl lock n err sy_locked_n
      else
         openv 'BKSYMSTR' fnum bksymstr_hndl lock r err sy_locked_n
      endif
      if trc(bksymstr_hndl)>1
         msg 'The system master file BKSYMSTR has more than one record.  This needs to be fixed as soon as possible.  Please contact DBA Support. ' windows 'W'
         quit
      endif

      ;AJF 4/6/00 - nlock the find so that if this is a lock R, we won't
      ;           - lock the record here - the programmer needs to be sure
      ;           - to do another findv in the program WITHOUT the nlock
      ;           - before saving to this file - yes the nlock is redundant
      ;           - if this is a lock N but it doesn't hurt anything
      ;           - we could instead do a clr @bksymstr_hndl rec
      ;           - right after the find and not put the nlock after it
      ;           - but that's a bit more dangerous because if the
      ;           - programmer forgot to re-find the record, it would
      ;           - create a duplicate record in the bksymstr file
      ;           - and the save would still work
      findv f fnum bksymstr_hndl key @0 nlock

      if flerr() <> 0
         msg "The BKSYMSTR file has not been set-up or could not be found. " windows 'w'
         trap rlck dflt
         ret .f.
      endif
      trap rlck dflt && 3/22/00
     ret .t.
      sy_locked_n:
         msg 'Unable to access the BKSYMSTR system file.  Another user may have it locked. ' windows 'warn'
         trap rlck dflt   
      ret .f.
   else_if lock_type = "F"
      trap rlck goto sy_locked
      openv 'BKSYMSTR' fnum bksymstr_hndl lock f err sy_locked
      if trc(bksymstr_hndl)>1
         msg 'The system master file BKSYMSTR has more than one record.  This needs to be fixed as soon as possible.  Please contact DBA Support. ' windows 'W'
         quit
      endif
      findv f fnum bksymstr_hndl key @0
      ;this should never happen, but just in case
      if flerr() <> 0
         msg "Unable to find the BKSYMSTR record after successfully locking the file.  There could be a network related problem.  If the problem persists after shutting down and re-booting your system, please contact DBA support. " windows 'w'
         trap rlck dflt
         ret .f.
      endif
      trap rlck dflt
     ret .t.
      sy_locked:
         xret = sys_file_lock(msg_type,lock_type)
         trap rlck dflt
      ret .f.
   else
      msg "You must pass an R/N/F to this function.  Please fix in source code, and recompile. " windows 'w'
      quit
   endif

ret .t.
#endp
::open_symstr
:open_ysmstr
define bkysmstr_hndl type i size 5
#proc
define xret type l local
define lock_type type a size 1 local
define msg_type type i size 1 local
func open_ysmstr lock_type,msg_type
   lock_type = up(lock_type) && force to upcase.
   if lock_type $ "RN"
      trap rlck goto ys_locked_n
      if lock_type = "N"
         openv 'BKYSMSTR' fnum bkysmstr_hndl lock n err ys_locked_n
      else
         openv 'BKYSMSTR' fnum bkysmstr_hndl lock r err ys_locked_n
      endif
      
      if trc(bkysmstr_hndl)>1
         msg 'The system master file BKYSMSTR has more than one record.  This needs to be fixed as soon as possible.  Please contact DBA Support. ' windows 'W'
         quit
      endif

      ;AJF 4/6/00 - nlock the find so that if this is a lock R, we won't
      ;           - lock the record here - the programmer needs to be sure
      ;           - to do another findv in the program WITHOUT the nlock
      ;           - before saving to this file - yes the nlock is redundant
      ;           - if this is a lock N but it doesn't hurt anything
      ;           - we could instead do a clr @bkysmstr_hndl rec
      ;           - right after the find and not put the nlock after it
      ;           - but that's a bit more dangerous because if the
      ;           - programmer forgot to re-find the record, it would
      ;           - create a duplicate record in the bkysmstr file
      ;           - and the save would still work

      findv f fnum bkysmstr_hndl key @0 nlock


      if flerr() <> 0
         msg "The BKYSMSTR file has not been set-up or could not be found. " windows 'w'
         trap rlck dflt
         ret .f.
      endif
      trap rlck dflt
     ret .t.
      ys_locked_n:
         msg 'Unable to access the BKYSMSTR system file.  Another user may have it locked. ' windows 'warn'
         trap rlck dflt   
      ret .f.
   else_if lock_type = "F"
      trap rlck goto ys_locked
      openv 'BKYSMSTR' fnum bkysmstr_hndl lock f err ys_locked
      if trc(bkysmstr_hndl)>1
         msg 'The system master file BKYSMSTR has more than one record.  This needs to be fixed as soon as possible.  Please contact DBA Support. ' windows 'W'
         quit
      endif
      findv f fnum bkysmstr_hndl key @0
      ;this should never happen, but just in case
      if flerr() <> 0
         msg "Unable to find the BKYSMSTR record after successfully locking the file.  There could be a network related problem.  If the problem persists after shutting down and re-booting your system, please contact DBA support. " windows 'w'
         trap rlck dflt
         ret .f.
      endif
      trap rlck dflt
     ret .t.
      ys_locked:
         xret = sys_file_lock(msg_type,lock_type)
         trap rlck dflt
      ret .f.
   else
      msg "You must pass an R/N/F to this function.  Please fix in source code, and recompile. " windows 'w'
      quit
   endif
ret .t.
#endp
::open_ysmstr
;
;**********************************************************************
;      sys_file_lock : generic message if system files are locked.
;                      parameter now being added 3/18/00
;                      two messages are possible now
;**********************************************************************
:sys_file_lock
#proc
define msg_type type i size 1 local
define lock_type type a size 1 local
func sys_file_lock msg_type, lock_type
   if msg_type=1 .a. lock_type='F'
      ;Means being called by a default settings program, and attempting a
      ;  file lock.
      msg 'Other users are currently logged into this company.  You can view these default settings but will not be able to change them. ' windows 'info'
   else
      ;Means being called from a non-default settings program or, if this is
      ;  a call from a default settings program, we are not attempting a
      ;  file lock.
      if lock_type='R' .o. lock_type='N'
         ;this message would be used in any program that is lock r'ing or lock n'ing
         msg 'Another user has the system file locked.  You cannot use this program at this time. ' windows 'i'
      else
         ;would only apply in a program that is lock f'ing
         msg "Other users are logged into this company.  You cannot use this program at this time." windows 'i'
      endif
   endif
ret .t.
::sys_file_lock
;End AjM 3/15/00------------------------------------------------------------
;4/14/00 new command to make YE entries into a file with the BKGLTRAN layout
;***************************************************************************
;This is the command that creates entries for the 'gltran' file.
;     You pass the file handle you wish to have saved to and it will create
;     the transaction record.  This command assumes that you have a bkglcoa
;     record active.  If you want a Credit pass a negative entry, debit post
;     a positive amount.
;
;         Example             openv 'BKGLTEMP' fnum bkgltemp_hndl lock r
;                             amt     = bkgl.current[14]
;                             post_dt = inc_date('y',bksy.fiscal.yr,1)-1
;                             make_gl_entry bkgltemp_hndl,post_dt,amt
;
;
;***************************************************************************
:make_gl_entry
#proc
define temp_hndl type i size 5 local
define post_dt type d size 8 local
define post_amt type n size 14 dec 2 local
define msg_type type i size 1 local
cmd make_gl_entry temp_hndl, post_dt, post_amt, msg_type
   if post_amt=0 then ret   &&AJF 4/20/00
   bkgl.trn.glacct = bkgl.acct
   bkgl.trn.gldpt  = bkgl.gldpt
   bkgl.trn.date   = post_dt
   if msg_type = 0
      bkgl.trn.desc= "YE close into Ret Earn"
   else
      bkgl.trn.desc= "YE post close into RE"
   endif
   bkgl.trn.entdte = date()
   if post_amt < 0
      bkgl.trn.dc  = "C"
      bkgl.trn.amt = abs(post_amt)
   else
      bkgl.trn.dc  = "D"
      bkgl.trn.amt = abs(post_amt)
   endif
   bkgl.trn.type   = "YE"
   bkgl.trn.post   = "N"
   bkgl.trn.invc   = ""
   bkgl.trn.code   = ""
   save @temp_hndl nocnf
ret
#endp
::make_gl_entry
;end 4/14/00
;
;AGL 1/31/02 rippoff of Fred's PI location tag.
:locsel
#proc
define ls.totlocs type i size 5 local
define ls.single type i size 5 local
define ls.tot  type i size 5 local
define ls.header0, ls.header1, ls.header2, ls.header3, ls.header4, ls.header5 type a size 100 local
define ls.title, ls.undsc type a size 100 local
define ls.cntr type i size 5 local
define ls.tagged type i size 5 local
define lstag type a size 3 local
define ls.prev type i size 5 local

func locsel ls.totlocs

;First step is to eliminate any previous tags
for(ls.cntr;1;ls.totlocs;1)
  loc.tag[ls.cntr] = ' '
next

ls.single = 0

;If there is only a single location, pre-tag it.
if ls.totlocs=1
   loc.tag[1]='Y'
   ls.tagged=1
else
   ls.tagged=0
endif

saves
xtrap_si_udc
if ls.single = 0
   ;multiple selections
   fnc_list 'ENTER Tag One,F5 Tag All','F10 Go,ESC Cancel','',''
else
   ;single selection only
   fnc_list 'ENTER Select','ESC Exit','',''
endif

window at 1,1 len 20 wdt max_cols() box 's' shd 'r' scolor sc wcolor get_win_color('MenuBkg') bcolor get_win_color('MenuBkg') USE_COLORS

ls.header0 = 'LOCATION LISTING'
setline ls.header1 with ls.header0
setline ls.header2 with fill(lchr(ls.header0,'l'),chr(223))
setline ls.header3 with 'Only locations Tagged here will be included in this MRP.'
setline ls.header4 with ''
setline ls.header5 with ''

setline ls.title with "Tag","Location  ","Location Name            ","Comments                      "
setline ls.undsc with "ÄÄÄ","ÄÄÄÄÄÄÄÄÄÄ","ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ","ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ"

ls.cntr = 1

if ls.single = 0
   ;allowing multiple selections
   trap F5  gosub LSALL
   trap F10 goto LSSAVE
endif

LSLIST:
    if ls.single = 0
       ;multiple selections (function returns T/F)
       listm ls.tag(),loc.loc,loc.name,loc.note cbf " " fline ls.header1,ls.header2,ls.header3,ls.header4,ls.header5,ls.title,ls.undsc noadd noshift cntr ls.cntr actv ls.totlocs maxa 200 enter ls.edit() use_traps
       {
         func ls.tag
           if loc.tag[ls.cntr] = ' '
              lstag = '   '
           else_if loc.tag[ls.cntr] = 'Y'
              lstag = ' '+chr(251)+' '
           endif
           ret lstag

         LSALL:
           for(mcntr;1;ls.totlocs;1)
             if loc.tag[mcntr] = ' '
                loc.tag[mcntr] = 'Y'
                ls.tagged = ls.tagged + 1
             endif
           next
           rdlist
           ret

         func ls.edit
           ;disallow deletions or additions
           if etyp() <> 'C'
              ret .f.
           endif
           ;This does the tagging/untagging of individual items
           if loc.tag[ls.cntr] = ' '
              loc.tag[ls.cntr] = 'Y'
              ls.tagged = ls.tagged + 1
           else_if loc.tag[ls.cntr] = 'Y'
              loc.tag[ls.cntr] = ' '
              ls.tagged = ls.tagged - 1
           endif
           if .n. windows()
              noredsp
           endif
           ret .t.
       }

       ;If get here, user has escaped from the list.
       if .n. zask('Exit without choosing any locations? ', .t.)
          goto LSLIST
       endif
       redsp
       xtrap_rstr_udc
       ret .f.

       LSSAVE:
         if ls.tagged = 0
            msg 'No locations have been tagged. ' windows 'info'
            goto LSLIST
         endif
         redsp
         xtrap_rstr_udc
         ret .t.

    else
       ;Only allowing a single selection like a lookup.  Function returns
       ;  the element # selected, or 0 if none.
       listm loc.loc,loc.name,loc.note cbf " " fline ls.header1,ls.header2,ls.header3,ls.header4,ls.header5,ls.title,ls.undsc noadd noshift cntr ls.cntr actv ls.totlocs maxa 200 MENU
       redsp
       xtrap_rstr_udc
       ret ls.cntr
    endif

#endp
::
;************************************************************************
;***********************************************************************
;LOCBLD
;
;Make sure BKICLOCM has been opened by the calling program.
;
;
:locbld
#proc

define bld.cfrom type a size 5 local
define bld.year type a size 4 local
define bld.qtr type a size 2 local
define bld.tot  type i size 5 local
define bld.condition type i size 5 local
define loc.tag type a size 1 array 200
define loc.loc type a size 10 array 200
define loc.note type a size 30 array 200
define loc.name type a size 25 array 200

func locbld 

updta loc.tag clr
updta loc.loc clr
updta loc.note clr
updta loc.name clr
bld.tot = 0
bld.condition = 0

   ;This is for selecting the locations.
   ;They will be able to select from all available locations.

   find F srch bkic.locm.code nlock
   while .t.
      bld.tot = bld.tot + 1

      if bld.tot > 200
         bld.condition = 1
         goto BLD.DONE
      endif

      loc.tag[bld.tot] = ' '
      loc.loc[bld.tot] = bkic.locm.code
      loc.name[bld.tot]= bkic.locm.name

      if bkic.locm.code='' .a. bkic.locm.name=''
         loc.name[bld.tot]='Default Location'
      endif

      find N srch BKICLOCM nlock
      if flerr(fnum('bkiclocm')) <> 0
         exit
      endif
   endw

if bld.tot = 0
   ;No locations
   bld.condition = 2
endif

BLD.DONE:
  if bld.condition <> 0
     updta loc.tag clr
     updta loc.loc clr
     updta loc.note clr
     updta loc.name clr
     bld.tot = 0

     if bld.condition = 1
        msg 'More than 200 locations. ' windows 'warn'
     else_if bld.condition = 2
        msg 'No locations. ' windows 'warn'
     endif
  endif

ret bld.tot

#endp
::
;************************************************************************
;******************************************************************************
;  FMZ 05/03/02
;  THIS FUNCTION IS OBSOLETE!  DO NOT USE IT!  It is preserved here
;  only for the benefit of the old BKPR programs.
;
;  msg.chk.post - displays message when no clearing account is set up yet
;    2/28/99      or when items get posted to the clearing account
;                 all GL posting routines should call this function
;  ;03/27/02 FMZ  Take out hard-coded program name references here.
;******************************************************************************
:msg.chk.post
#proc

define postfail,postoth type i size 1 local
func msg.chk.post postfail,postoth

  ; displays message when no clearing account is set up yet
  ;             (e.g. when POST.FAIL=1)   
  if postfail=1
   message[1]='A GL Account was not found for at least one of the posted items in'
   message[2]='this process.  Missing GL Account transactions normally get posted'
   message[3]='to your Clearing Account; however, a Clearing Account has not been'
   message[4]='set up yet and therefore this transaction is out of balance.  Go'
   message[5]='to "General Ledger Defaults" and set up a default Clearing Account.'
   message[6]='Then go to "Print/Post General Ledger Batches" and print out your'
   message[7]='GL batch transactions to find the missing entries, then add the '
   message[8]='missing entries through "Edit General Ledger Batch Entries" to get'
   message[9]='back in balance.'
   msg_list msg_ptr,9
  endif


 ; message displayed when items get posted to the Clearing Account
 ;              (POST.OTHER=1)   

 if postoth=1
   message[1]='A GL Account was not found for at least one of the posted items in'
   message[2]='this process.  Missing GL Account transactions get posted to the'
   message[3]='default Clearing Account defined in "General Ledger Defaults".'
   message[4]='Go to "Print/Post General Ledger Batches" to get a listing of your'
   message[5]='Clearing Account entries and edit the entries for the correct'
   message[6]='GL Account(s) through "Edit General Ledger Batch Entries".'
   msg_list msg_ptr,6
 endif

 ret .t.

;
#endp
::end of msg.chk.post routine
